# Copy to .env and fill in. Never commit .env.
# LLM for the parser/critic/report nodes: set ONE key (OpenRouter gives access to any model it lists).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: openrouter | anthropic (default: whichever key above is set, OpenRouter first)
ISR_FORGE_LLM_PROVIDER=
# Optional: model id in the provider's naming. OpenRouter examples: anthropic/claude-opus-5.5 (default),
# openai/gpt-5.6-sol, google/gemini-3.8-flash. Anthropic default: claude-opus-5-5. Must support structured outputs.
ISR_FORGE_MODEL=
# Optional: set to 1 to run tests/test_agent_e2e.py against the configured live LLM instead of the scripted one
ISR_FORGE_LIVE_LLM=
# Optional, host runs only: folder for the cached propeller CT/CP tables (default: .cache/prop_tables in the repo).
# Warm it with: python -m src.tools.propulsion.prop_tables --warm. Left commented out on purpose: Docker Compose
# passes .env into the containers, and the image keeps its tables in /opt/prop_tables (set in the Dockerfile).
# PROP_TABLE_CACHE_DIR=/absolute/path/to/prop_tables
