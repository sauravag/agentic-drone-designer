# Copy to .env and fill in. Never commit .env.
# Used by the LangGraph parser/critic/report nodes (Milestone 5).
ANTHROPIC_API_KEY=
# Optional: Claude model for the agent nodes (default claude-opus-5-5)
ISR_FORGE_MODEL=
# Optional: set to 1 to run tests/test_agent_e2e.py against live Claude instead of the scripted LLM
ISR_FORGE_LIVE_LLM=
